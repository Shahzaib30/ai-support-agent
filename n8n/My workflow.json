    {
      "parameters": {
        "jsCode": "// Validates and normalizes the inbound payload before it ever reaches\n// FastAPI. The upstream Telegram relay (or any other caller of this\n// webhook) is expected to send { telegram_chat_id, message, customer_name }.\n// If this webhook is fed a raw Telegram Bot API update instead, its\n// top-level update_id is carried through as event_id so /chat can\n// deduplicate retried Telegram webhook deliveries.\nconst body = $input.first().json.body || {};\n\nconst chatId = body.telegram_chat_id;\nconst message = body.message;\n\nif (!chatId || !String(message || '').trim()) {\n  throw new Error('Malformed request: telegram_chat_id and message are required');\n}\n\nconst result = {\n  telegram_chat_id: String(chatId),\n  message: String(message).trim(),\n  customer_name: body.customer_name || null,\n  channel: 'telegram',\n};\n\nif (body.update_id) {\n  result.event_id = String(body.update_id);\n}\n\nreturn [{ json: result }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -416,
        -368
      ],
