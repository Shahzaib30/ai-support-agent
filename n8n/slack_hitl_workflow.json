      "id": "c3d4e5f6-a7b8-4c9d-8e0f-1a2b3c4d5e6f",
      "name": "Fetch escalation thread parent",
      "notes": "Looks up the ORIGINAL escalation alert message so we can read its structured metadata (conversation_id) instead of asking a human to type a UUID."
    },
    {
      "parameters": {
        "jsCode": "// Resolve which conversation this Slack thread reply belongs to.\n//\n// Preferred: the escalation alert (parent message) was posted by the\n// backend with structured Slack message metadata containing conversation_id\n// -- no human ever has to type anything but a normal reply.\n//\n// Fallback: if metadata is missing for any reason (older message, API\n// hiccup), extract the UUID that's still visibly printed in the alert's\n// text/blocks for humans to read.\n//\n// If neither resolves a conversation_id, we stop here rather than calling\n// the API with a guess -- this is the \"malformed/unresolvable reply\"\n// safety net.\nconst response = $input.first().json;\nconst parent = (response.messages || [])[0];\n\nlet conversationId = null;\n\nif (parent && parent.metadata && parent.metadata.event_payload) {\n  conversationId = parent.metadata.event_payload.conversation_id || null;\n}\n\nif (!conversationId && parent) {\n  const haystack = (parent.text || '') + JSON.stringify(parent.blocks || '');\n  const match = haystack.match(/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/);\n  if (match) conversationId = match[0];\n}\n\nif (!conversationId) {\n  return [];\n}\n\nconst reply = $('Slack Trigger').item.json;\nconst text = (reply.text || '').trim();\nif (!text) {\n  return [];\n}\n\nconst agentName = (reply.user_profile && (reply.user_profile.display_name || reply.user_profile.real_name)) || 'Support Agent';\n\nreturn [{\n  json: {\n    conversation_id: conversationId,\n    message: text,\n    agent_name: agentName,\n    event_id: reply.ts,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        0
      ],
