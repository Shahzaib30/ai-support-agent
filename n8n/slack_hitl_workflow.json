      "notes": "Thread replies from a real Slack user (not a bot)"
    },
    {
      "parameters": {
        "jsCode": "// Slack thread reply format:  UUID | message text\nconst item = $input.first().json;\nconst text = (item.text || '').trim();\n\nconst match = text.match(/^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})\\s*\\|\\s*([\\s\\S]+)$/);\n\n// Not in \"UUID | message\" format -> stop the workflow for this item\nif (!match) {\n  return [];\n}\n\nconst agentName = item.user_profile?.display_name ||\n                  item.user_profile?.real_name ||\n                  'Support Agent';\n\nreturn [{\n  json: {\n    conversation_id: match[1],\n    message: match[2].trim(),\n    agent_name: agentName,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -224,
        0
      ],
      "id": "7f3b8c74-2d2c-4e77-9c77-3dad0f2b8c03",
