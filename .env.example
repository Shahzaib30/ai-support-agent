# ── LLM (DeepSeek, OpenAI-compatible API) ──────────────────────────────────

DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# ── LANGSMITH TRACING (optional — RAG pipeline tracing) ────────────────────

LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.langsmith.com/v2
LANGSMITH_PROJECT_NAME=ai-support-agent


# ── DISCORD ──────────────────────────────────────────────────────────────

DISCORD_BOT_TOKEN=your_discord_bot_token_here
# Base URL the Discord bot process uses to reach the FastAPI app. The
# docker-compose default (service name "api") already matches — only
# override this for local, non-docker development.
API_URL=http://api:8000


# ── WHATSAPP (Meta Cloud API) ───────────────────────────────────────────────

WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
# Any string you choose — Meta echoes it back during webhook verification.
WHATSAPP_VERIFY_TOKEN=choose_a_verification_string_here


# ── SLACK (Human-in-the-loop escalations) ───────────────────────────────────
# Requires a real Slack App (not just an Incoming Webhook) with a Bot Token,
# scopes: chat:write, channels:history (or groups:history for a private
# channel) — needed to attach and read back structured message metadata so
# agents can reply in-thread without typing a conversation ID. See README
# "Slack HITL setup".

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token-here
SLACK_CHANNEL_ID=your_escalations_channel_id_here


# ── POSTGRESQL ───────────────────────────────────────────────────────────

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_support_agent
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}


# ── REDIS ────────────────────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}


# ── VECTOR STORE / RAG ───────────────────────────────────────────────────

FAISS_INDEX_PATH=./vector_store/faiss_index
RAG_SIMILARITY_THRESHOLD=0.65


# ── SENTIMENT / ESCALATION ──────────────────────────────────────────────

SENTIMENT_NEGATIVE_THRESHOLD=-0.5
SENTIMENT_ESCALATION_COUNT=3


# ── FASTAPI ──────────────────────────────────────────────────────────────

API_HOST=0.0.0.0
API_PORT=8000


# ── MONITORING (docker-compose Grafana/n8n containers) ──────────────────

PROMETHEUS_PORT=9090
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
